# ds-worker configuration.
# Copy to ~/.config/ds-worker/config.env and `chmod 600` it (install.sh does both).
# The file is sourced by bash, so you can read secrets from elsewhere instead of
# pasting them here, e.g. DS_AUTH_TOKEN="$(cat ~/.secrets/deepseek)".

# Backend: any Anthropic-compatible endpoint. Leave DS_BASE_URL empty to use
# Claude Code's own login (your Claude subscription or ANTHROPIC_API_KEY).
DS_BASE_URL=https://api.deepseek.com/anthropic
DS_AUTH_TOKEN=
DS_MODEL=deepseek-chat

# Defaults for every run (each can be overridden on the command line).
# DS_EFFORT=high                  # low | medium | high
# DS_TIMEOUT=7200                 # seconds
# DS_RULES_FILE=~/.config/ds-worker/rules.md

# Where run logs and inboxes live.
# DS_RUNS_DIR=~/.local/state/ds-worker/runs

# Workers run unattended, so by default they may use every tool without asking.
# Set a stricter Claude Code permission mode here if you prefer (e.g. acceptEdits).
# DS_PERMISSION_MODE=bypassPermissions

# Header put in front of messages sent with ds-say.
# DS_INBOX_HEADER="[Message from the dispatcher]"

# Path to the claude CLI if it is not on PATH.
# DS_CLAUDE_BIN=claude
